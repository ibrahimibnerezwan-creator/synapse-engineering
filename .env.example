# Turso Database (Leave empty for local SQLite fallback)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google Gemini AI (For Vision OCR & Technical Chat Consultant)
GEMINI_API_KEY=

# Meta / Facebook Ads Tracking
NEXT_PUBLIC_FB_PIXEL_ID=1256000382752238
FB_ACCESS_TOKEN=

# Cloudflare R2 Storage (For datasheets & part photo uploads)
CF_ACCOUNT_ID=
CF_ACCESS_KEY_ID=
CF_SECRET_ACCESS_KEY=
CF_BUCKET_NAME=synapse-assets
CF_R2_PUBLIC_URL=

# Admin Security
ADMIN_PASSWORD=
# At least 32 random characters; required for admin sessions.
JWT_SECRET=

# Optional Gemini model fallback chain
AI_MODEL_CHAIN=gemini-3.6-flash,gemini-flash-latest,gemini-3.5-flash-lite

# Public URL for catalog exports; defaults to the request origin.
NEXT_PUBLIC_SITE_URL=https://synapse-engineering.vercel.app
